//
//  Secrets.example.xcconfig
//  Valtyde
//
//  SAFE TO COMMIT: This file contains placeholder values only.
//  ACTUAL SECRETS go in Secrets.xcconfig (which is gitignored).
//
//  Setup Instructions:
//  1. Copy this file to: Secrets.xcconfig
//  2. Replace placeholder values with your actual Supabase credentials
//  3. NEVER commit Secrets.xcconfig to git
//

// Supabase Project URL
SUPABASE_URL = https:/$()/YOUR_PROJECT_ID.supabase.co

// Supabase Publishable Key (anon key)
// This is safe to use in client apps (RLS enforced)
SUPABASE_PUBLISHABLE_KEY = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ANON_KEY_HERE

// ⚠️ NEVER use service_role key in client apps!
// Only use the anon/publishable key above.

// Finnhub API key — live stock quotes (same provider as the marketing site).
// Free key at https://finnhub.io/dashboard. Leave the placeholder to run on
// mock data; the app falls back to mock automatically when this is unset.
FINNHUB_API_KEY = YOUR_FINNHUB_KEY_HERE
